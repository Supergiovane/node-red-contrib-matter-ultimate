{
  "engines": {
    "node": ">=20.18.1"
  },
  "author": {
    "name": "Massimo Saccani",
    "email": "maxsupergiovane@icloud.com",
    "url": "https://youtube.com/@maxsupervibe"
  },
  "license": "MIT",
  "name": "node-red-contrib-matter-ultimate",
  "version": "1.0.0-beta.0",
  "description": "Matter Controller and Bridge for Node-RED, with optional KNX Ultimate integration.",
  "files": [
    "nodes/",
    "resources/",
    "examples/",
    "README.md",
    "MIGRATION.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/assets/brand/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Supergiovane/node-red-contrib-matter-ultimate.git"
  },
  "keywords": [
    "node-red",
    "matter",
    "ultimate",
    "home-automation"
  ],
  "dependencies": {
    "@matter/main": "^0.17.9",
    "@matter/nodejs": "^0.17.9",
    "@project-chip/matter.js": "^0.17.9",
    "lodash": "4.18.1",
    "simple-get": "4.0.1",
    "winston": "^3.17.0",
    "@matter/general": "^0.17.9",
    "@matter/model": "^0.17.9",
    "@matter/protocol": "^0.17.9"
  },
  "devDependencies": {
    "chai": "^4.3.10",
    "mocha": "^10.4.0",
    "knxultimate": "6.0.6"
  },
  "node-red": {
    "version": ">=3.1.1",
    "plugins": {
      "matterUltimateAdmin": "/nodes/matterUltimate-admin.js",
      "matterUltimateMigration": "/nodes/plugins/matterUltimate-migration.html"
    },
    "nodes": {
      "matterUltimateController": "/nodes/matterUltimateController.js",
      "matterUltimateBridge": "/nodes/matterUltimateBridge.js",
      "matter-ultimate-bridge-config": "/nodes/matter-ultimate-bridge-config.js",
      "matter-ultimate-config": "/nodes/matter-ultimate-config.js"
    }
  },
  "scripts": {
    "test": "mocha \"test/**/*.test.js\" && node scripts/check-node-load.js",
    "test:unit": "mocha \"test/**/*.test.js\"",
    "docs:prepare": "node scripts/prepare-docs.js",
    "docs:build": "npm run docs:prepare && jekyll build --source docs --destination docs/_site",
    "docs:serve": "npm run docs:prepare && jekyll serve --source docs --destination docs/_site --host 127.0.0.1"
  },
  "peerDependencies": {
    "node-red-contrib-knx-ultimate": ">=7.1.1"
  },
  "peerDependenciesMeta": {
    "node-red-contrib-knx-ultimate": {
      "optional": true
    }
  },
  "homepage": "https://supergiovane.github.io/node-red-contrib-matter-ultimate/",
  "publishConfig": {
    "access": "public",
    "tag": "latest",
    "registry": "https://registry.npmjs.org/"
  }
}
